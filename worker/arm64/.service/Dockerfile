# GENERATED by scripts/gen_dockerfiles.sh from llama/build-stage.Dockerfile and
# worker/runtime.Dockerfile. Edit those files, not this one. linux/arm64 variant.
# ---- llama.cpp, CPU only (this stage is the same text in head/ and worker/, so BuildKit
# builds it once and the two images get the same binaries) ----
# The base is pinned by the digest of the multi-arch index of debian:bookworm-slim (the pin
# of celaut-basics/echo-chat). apt reads a frozen snapshot of the Debian archive.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS llama-build
ARG DEBIAN_SNAPSHOT=20261004T000000Z
RUN sed -i \
      -e "s|^URIs: http://deb.debian.org/debian\$|URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" \
      -e "s|^URIs: http://deb.debian.org/debian-security\$|URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
      -e '/^URIs: /a Check-Valid-Until: no' \
      /etc/apt/sources.list.d/debian.sources \
    && [ "$(grep -c '^URIs: http://snapshot.debian.org/' /etc/apt/sources.list.d/debian.sources)" = 2 ] \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install --no-install-recommends -y \
        build-essential cmake ninja-build git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# llama.cpp v0.8.0 (2026-10-28), by commit. GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS: one
# CPU backend per x86-64 level (sse42 ... zen4, sapphirerapids), the best one is chosen at
# run time, so the image runs on any x86-64 node and uses AVX2/AVX-512 where it exists.
# On arm64 the variants are armv8.0 ... armv8.6 (+DOTPROD, FP16, SVE, I8MM, SVE2). The two
# armv9.2 variants (SME) are removed before cmake: GCC 12 of bookworm does not know
# `-march=armv9.2-a+...+sme`. The sed changes nothing on amd64.
# GGML_RPC: the RPC backend (llama-server --rpc) and ggml-rpc-server.
ARG LLAMA_COMMIT=8642541b255bfb5dc39cd351a178be09013a55d6
RUN git init -q /src && cd /src \
    && git fetch -q --depth 1 https://github.com/ggml-org/llama.cpp.git "${LLAMA_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && sed -i '/ggml_add_cpu_backend_variant(armv9\.2_[12] /d' ggml/src/CMakeLists.txt \
    && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DGGML_RPC=ON -DGGML_NATIVE=OFF \
        -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON -DBUILD_SHARED_LIBS=ON \
        -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_CURL=OFF -DLLAMA_OPENSSL=OFF \
    && cmake --build build -j "$(nproc)" --target llama-server ggml-rpc-server \
    && mkdir -p /opt/llama/bin \
    && cp -a build/bin/llama-server build/bin/ggml-rpc-server build/bin/*.so* /opt/llama/bin/ \
    && strip --strip-unneeded /opt/llama/bin/* \
    && rm -rf /src

# ---- the worker: ggml-rpc-server only ----
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
SHELL ["/bin/bash", "-c"]
ARG DEBIAN_SNAPSHOT=20261004T000000Z
# libgomp1: the OpenMP runtime of the CPU backend (libstdc++6 and libgcc-s1 are in the base).
RUN sed -i \
      -e "s|^URIs: http://deb.debian.org/debian\$|URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" \
      -e "s|^URIs: http://deb.debian.org/debian-security\$|URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
      -e '/^URIs: /a Check-Valid-Until: no' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install --no-install-recommends -y libgomp1=12.2.0-14+deb12u1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 llama \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin llama
COPY --from=llama-build /opt/llama /opt/llama
# The entrypoint (service.json init.entry_path). The guest init starts it as PID 1 and as
# root; ggml-rpc-server runs as the service user, with one thread for each vCPU of the
# instance. It listens on all the addresses of the instance on port 50052 (the slot of
# service.json): the worker declares no network, and the node lets only the parent
# instance reach the port of a child (network.ISOLATE_INTERNAL_CHILDREN). The llama.cpp
# RPC protocol has no authentication.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'export LD_LIBRARY_PATH=/opt/llama/bin' \
        'exec setpriv --reuid 10001 --regid 10001 --clear-groups /opt/llama/bin/ggml-rpc-server -H 0.0.0.0 -p 50052 -t "$(nproc)"' \
        > /entrypoint.sh \
    && chmod 0755 /entrypoint.sh
# Build-time smoke test: the server starts as the service user and accepts a connection.
RUN (LD_LIBRARY_PATH=/opt/llama/bin setpriv --reuid 10001 --regid 10001 --clear-groups \
        /opt/llama/bin/ggml-rpc-server -H 127.0.0.1 -p 50052 -t 1 > /tmp/rpc.log 2>&1 &) \
    && for i in $(seq 1 50); do (exec 3<>/dev/tcp/127.0.0.1/50052) 2>/dev/null && break; sleep 0.2; done \
    && (exec 3<>/dev/tcp/127.0.0.1/50052) && grep -q 'CPU' /tmp/rpc.log && echo 'smoke test: rpc-server ok' \
    && rm -f /tmp/rpc.log
